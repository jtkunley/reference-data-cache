{
    "name": "cache-manager",
    "version": "1.0.0",
    "private": true,
    "description": "Typed cache clients (CacheReader, CacheOwner) with named domains, loaders, and pluggable CacheTier backends.",
    "keywords": [
        "cache",
        "redis",
        "typescript"
    ],
    "license": "UNLICENSED",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
